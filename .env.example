# AURA TIME V2 — Optional Server-Side Environment Variables
# Copy to .env for local or production deployment. Never expose secrets in VITE_ variables.

# Optional: Server-side Gemini API key for consented AI Weekly Reflections & Task Breakdown
# When omitted, AURA TIME automatically uses its deterministic local rule-based fallback.
GEMINI_API_KEY=

# Optional: Port for Express + Vite server (defaults to 3000)
PORT=3000
